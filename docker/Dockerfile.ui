FROM php:8.2-fpm-alpine

# Install nginx and supervisor
RUN apk add --no-cache nginx supervisor sqlite-dev

# PHP extensions (sqlite-dev required for pdo_sqlite on Alpine)
RUN docker-php-ext-install pdo pdo_sqlite

# PHP-FPM: listen on TCP 9000 (no socket permission issues)
RUN sed -i 's|listen = 127.0.0.1:9000|listen = 9000|' /usr/local/etc/php-fpm.d/www.conf

# Nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Supervisor config
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /var/www/html
COPY ui/ .

# Output volume for SQLite state (shared with api service)
VOLUME ["/app/output"]

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO /dev/null http://127.0.0.1/ || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
