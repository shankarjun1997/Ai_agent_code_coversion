FROM php:8.3-cli-bookworm

RUN apt-get update && apt-get install -y \
    git zip unzip libssl-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install OpenSwoole and uopz (required by ZealPHP)
# openswoole 26.x is the latest stable on PECL for PHP 8.3
RUN pecl install openswoole uopz \
    && docker-php-ext-enable openswoole uopz

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Install PHP deps first (layer cache)
COPY ui/composer.json ui/composer.lock* ./
RUN composer install --no-dev --optimize-autoloader --no-scripts

# Copy app code
COPY ui/ .

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
    CMD php -r "\
\$ctx = stream_context_create(['http'=>['timeout'=>3]]);\
\$r = @file_get_contents('http://127.0.0.1:8080/', false, \$ctx);\
exit(\$r === false ? 1 : 0);\
"

CMD ["php", "server.php"]
